# ==============================================================================
# Environment Configuration Template (.env.example)
# Project: An Agentic AI Framework for Reliable and Evidence-Based Code Review
# Note: Copy this file to .env and replace placeholder values. Do NOT commit .env.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- FastAPI Server Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="Agentic AI Code Reviewer"
SECRET_KEY=replace-with-a-secure-random-32-character-secret-key
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- PostgreSQL Database Configuration ---
# Note: Default host port is 5433 per ADR-0001 (container port 5432 mapped to host 5433)
POSTGRES_HOST=localhost
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=agentic_reviewer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/agentic_reviewer

# --- Redis Task Queue (ARQ) & Caching ---
# Note: Default host port is 6380 (container port 6379 mapped to host 6380 to avoid collision)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6380/0

# --- ARQ Task Queue Settings ---
ARQ_QUEUE_NAME=agentic_review_queue
ARQ_JOB_TIMEOUT_SECONDS=600
ARQ_MAX_JOBS=10
ARQ_MAX_RETRIES=3
ARQ_RETRY_DELAY_SECONDS=10
ARQ_KEEP_RESULT_SECONDS=3600

# --- GitHub App Integration ---
# GitHub App ID and Webhook secret used for HMAC-SHA256 signature verification
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
# Path to the GitHub App private key (.pem) or direct multiline PEM string in GITHUB_APP_PRIVATE_KEY
GITHUB_PRIVATE_KEY_PATH=secrets/github-app.private-key.pem
GITHUB_APP_PRIVATE_KEY=
# Fallback GitHub App installation ID (when not provided in webhook events)
GITHUB_APP_INSTALLATION_ID=

# --- Local Repository Workspace Management (Phase 1.9) ---
# Directory where isolated repositories are cloned/checked out for review
# Defaults to system temp directory (e.g. /tmp/agentic_workspaces on Linux or %TEMP%\agentic_workspaces on Windows)
REVIEW_WORKSPACE_ROOT=
WORKSPACE_COMMAND_TIMEOUT_SECONDS=60.0
WORKSPACE_MAX_SIZE_BYTES=524288000
WORKSPACE_MIN_DISK_FREE_BYTES=1073741824
WORKSPACE_RETENTION_ON_FAILURE=false
WORKSPACE_ENABLED=true


# --- LLM Provider Configuration ---
# Active LLM provider: openai, anthropic, or google
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic Configuration (Alternative / Fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Configuration (Alternative / Fallback)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-pro

# --- Deterministic Static Analysis Tooling (Phase 2.1) ---
DOCKER_SANDBOX_ENABLED=true
STATIC_ANALYSIS_ENABLED=true
STATIC_ANALYSIS_TIMEOUT_SECONDS=60.0
SEMGREP_TIMEOUT_SECONDS=60.0
BANDIT_TIMEOUT_SECONDS=45.0
PIP_AUDIT_TIMEOUT_SECONDS=45.0
STATIC_ANALYSIS_MEMORY_LIMIT=512m
STATIC_ANALYSIS_CPU_LIMIT=1.0
STATIC_ANALYSIS_MAX_OUTPUT_BYTES=10485760
STATIC_ANALYSIS_NETWORK=none
SEMGREP_IMAGE=semgrep/semgrep:1.78.0
BANDIT_IMAGE=ghcr.io/pycqa/bandit/bandit:1.9.4
PIP_AUDIT_IMAGE=pip-audit:2.7.3
SEMGREP_CONTAINER_USER=1000:1000
BANDIT_CONTAINER_USER=1000:1000
PIP_AUDIT_CONTAINER_USER=1000:1000
SEMGREP_RULES_PATH=
PIP_AUDIT_CACHE_DIR=
STATIC_ANALYSIS_MAX_EVIDENCE_ITEMS_PER_RUN=1000

# --- Review & Verification Constraints ---
# Minimum calibrated confidence required by Critic Agent before publishing (NFR-1)
MIN_VERIFICATION_CONFIDENCE=0.75
MAX_REVIEW_FILES=50
MAX_DIFF_LINES_PER_CHUNK=400
