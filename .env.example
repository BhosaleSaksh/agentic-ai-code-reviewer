# ==============================================================================
# Environment Configuration Template (.env.example)
# Project: An Agentic AI Framework for Reliable and Evidence-Based Code Review
# Note: Copy this file to .env and replace placeholder values. Do NOT commit .env.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- FastAPI Server Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="Agentic AI Code Reviewer"
SECRET_KEY=replace-with-a-secure-random-32-character-secret-key
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- PostgreSQL Database Configuration ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_reviewer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_reviewer

# --- Redis Task Queue (ARQ) & Caching ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- GitHub App Integration ---
# GitHub App ID and Webhook secret used for HMAC-SHA256 signature verification
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
# Path to the GitHub App private key (.pem)
GITHUB_PRIVATE_KEY_PATH=secrets/github-app.private-key.pem

# --- LLM Provider Configuration ---
# Active LLM provider: openai, anthropic, or google
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic Configuration (Alternative / Fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Configuration (Alternative / Fallback)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-pro

# --- Deterministic Static Analysis Tooling ---
DOCKER_SANDBOX_ENABLED=true
SEMGREP_TIMEOUT_SECONDS=60
BANDIT_TIMEOUT_SECONDS=45
PIP_AUDIT_TIMEOUT_SECONDS=45

# --- Review & Verification Constraints ---
# Minimum calibrated confidence required by Critic Agent before publishing (NFR-1)
MIN_VERIFICATION_CONFIDENCE=0.75
MAX_REVIEW_FILES=50
MAX_DIFF_LINES_PER_CHUNK=400
